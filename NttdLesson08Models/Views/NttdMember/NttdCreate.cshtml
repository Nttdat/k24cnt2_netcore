@model NttdLesson08Models.Models.NttdMember

@{
    ViewData["Title"] = "Thêm mới thành viên";
}
<form asp-action="NttdCreate" method="post">
    <div class="card p-3">
        <div class="card-header">
            <h1>@ViewData["Title"]</h1>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="NttdMemberId" class="control-label"></label>
                        <input asp-for="NttdMemberId" class="form-control" />
                        <span asp-validation-for="NttdMemberId" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="NttdUserName" class="control-label"></label>
                        <input asp-for="NttdUserName" class="form-control" />
                        <span asp-validation-for="NttdUserName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="NttdPassword" class="control-label"></label>
                        <input asp-for="NttdPassword" class="form-control" />
                        <span asp-validation-for="NttdPassword" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="NttdFullName" class="control-label"></label>
                        <input asp-for="NttdFullName" class="form-control" />
                        <span asp-validation-for="NttdFullName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="NttdEmail" class="control-label"></label>
                        <input asp-for="NttdEmail" class="form-control" />
                        <span asp-validation-for="NttdEmail" class="text-danger"></span>
                    </div>

                </div>
            </div>
        </div>

        <div class="card-footer">
            <div class="form-group">
                <input type="submit" value="Ghi lại" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </div>
    </div>
</form>