<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NttdLesson06Views</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NttdLesson06Views.styles.css" asp-append-version="true" />
</head>
<body>
    @Html.Partial("_NttdHeaderPatrialView")


    <div class="container">
        <main role="main" class="row pb-3">
            <div class="col-md-3" style="min-height:550px">
                @await Component.InvokeAsync("Category")
            </div>

		<div class="col-md-9" </div>
		@RenderBody()
        </main>
    </div>

@Html.Partial("_NttdFooter")
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
