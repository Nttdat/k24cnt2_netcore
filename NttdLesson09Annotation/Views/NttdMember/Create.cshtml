@model NttdLesson09Annotation.Models.DataModels.NttdMember

@{
    ViewData["Title"] = "Thêm thành viên mới";
}

<h1>@ViewData["Title"]</h1>

<h4>NttdMember</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="NttdMemberUserName" class="control-label"></label>
                <input asp-for="NttdMemberUserName" class="form-control" />
                <span asp-validation-for="NttdMemberUserName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NttdMemberPassWord" class="control-label"></label>
                <input asp-for="NttdMemberPassWord" class="form-control" />
                <span asp-validation-for="NttdMemberPassWord" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NttdMemberEmail" class="control-label"></label>
                <input asp-for="NttdMemberEmail" class="form-control" />
                <span asp-validation-for="NttdMemberEmail" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NttdMemberPhoneNumber" class="control-label"></label>
                <input asp-for="NttdMemberPhoneNumber" class="form-control" />
                <span asp-validation-for="NttdMemberPhoneNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NttdMemberBirthday" class="control-label"></label>
                <input asp-for="NttdMemberBirthday" class="form-control" />
                <span asp-validation-for="NttdMemberBirthday" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
