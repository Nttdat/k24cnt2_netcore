@model IEnumerable<NttdLesson07Models.Models.DataModels.NttdMember>

@{
    ViewData["Title"] = "Danh sách thành viên";
}

<div class="card p-3">
    <h1>@ViewData["Title"]</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary my-1">Thêm mới</a>
    </p>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.NttdMemberId)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.NttdUserName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.NttdPassword)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.NttdFullName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.NttdEmail)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.NttdMemberId)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NttdUserName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NttdPassword)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NttdFullName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NttdEmail)
                    </td>
                    <td>
                        @Html.ActionLink("Edit", "Edit", new { /* id=item.PrimaryKey */ }) |
                        @Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ }) |
                        @Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>